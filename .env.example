# Токен от @BotFather
BOT_TOKEN=123456:AAAA-your-token-here

# ID админов через запятую (свой id можно узнать у @userinfobot)
ADMIN_IDS=111111111

# Путь к базе
DB_PATH=sakura.db

# Сколько видео нужно в анкете и для обмена
VIDEOS_PER_TRADE=5

# Сколько друзей нужно пригласить для премиума навсегда
PREMIUM_REFERRALS_REQUIRED=5

# Часов буста анкеты за одного приглашённого
BOOST_HOURS_PER_REFERRAL=1

# true  -> без премиума нельзя открыть "Искать трейды"
# false -> искать можно всем, премиум нужен для стрелки "назад" (⬅️)
SEARCH_REQUIRES_PREMIUM=false

# Цена премиума в Telegram Stars (0 = продажа за звёзды выключена)
PREMIUM_STARS_PRICE=150

# Часов между повторными обменами с одной и той же анкетой
REPEAT_TRADE_COOLDOWN_HOURS=24
